

# Environment variables for docker-compose.yaml (Beelink SER5 Max production)
# Set COMMON_PATH to the absolute path where your data folders are stored on the Beelink.
COMMON_PATH=C:\Users\Ahut\Projects\home-media-server
TZ=America/New_York
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
# Adjust COMMON_PATH above if you clone to a different location.

MEDIA_MOVIES=d:/media/Movies
MEDIA_TV=d:/media/TV
MEDIA_PERSONAL=d:/personal
MEDIA_TEST=d:/media/test