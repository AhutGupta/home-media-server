# Base paths and timezone
COMMON_PATH=/srv/home-media-server
TZ=UTC

# Media library locations (update to match your storage layout)
MEDIA_MOVIES=${COMMON_PATH}/media/movies
MEDIA_TV=${COMMON_PATH}/media/tv
MEDIA_MUSIC=${COMMON_PATH}/media/music
MEDIA_PERSONAL=${COMMON_PATH}/media/personal
MEDIA_TEST=${COMMON_PATH}/media/test
MEDIA_PODCASTS=${COMMON_PATH}/podcasts

# Optional: read-only mounts for external drives/NAS
DRIVE_MOVIES=/mnt/media/movies
DRIVE_TV_SERIES=/mnt/media/tv
DRIVE_MUSIC=/mnt/media/music
DRIVE_TEST=/mnt/media/test

# Optional: Tailscale auth key (create one at https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-xxxxxxxxxxxxxxxxxxxx

# Optional: VPN credentials (only if using Proton/Nord compose variants)
# NordVPN (OpenVPN)
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_REGIONS=Belgium

# Proton VPN (WireGuard)
ENDPOINT_IP=
WIREGUARD_ADDR=
ENDPOINT_PORT=51820
DNS_ADDRESS=1.1.1.1
PUBLIC_KEY=
PRIVATE_KEY=
